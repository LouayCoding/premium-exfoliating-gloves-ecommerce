# WooCommerce REST API Configuration
# Kopieer dit bestand naar .env.local en vul je eigen credentials in

# WooCommerce REST API Endpoint
# Voorbeeld: https://jouwwebsite.nl/wp-json/wc/v3
NEXT_PUBLIC_REST_API_ENDPOINT=https://jouwwebsite.nl/wp-json/wc/v3

# Currency (standaard: EUR)
NEXT_PUBLIC_CURRENCY=EUR

# WooCommerce API Credentials
# Genereer deze in WooCommerce > Instellingen > Geavanceerd > REST API
WOOCOMMERCE_CONSUMER_KEY=ck_jouw_consumer_key_hier
WOOCOMMERCE_CONSUMER_SECRET=cs_jouw_consumer_secret_hier

# Stripe Configuration (optioneel)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_jouw_stripe_key
STRIPE_SECRET_KEY=sk_test_jouw_stripe_secret

# Mollie Configuration (VERPLICHT voor betalingen)
# Voor productie: gebruik live_ key
# Voor development: gebruik test_ key
MOLLIE_API_KEY=live_R4tqQM9VQSGJR2zAJcg2capEa2dHr8

# Webhook URL (moet publiek toegankelijk zijn)
NEXT_PUBLIC_WEBHOOK_URL=https://jouw-vercel-url.vercel.app
